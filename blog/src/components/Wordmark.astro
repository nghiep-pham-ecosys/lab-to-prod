---
import { BRAND } from '../lib';

// The benzene mark of brand/build.py (mark_hexagon at lockup weight), for options with `lockup: true`.
const pt = (r: number, i: number) => [r * Math.cos(((30 + 60 * i) * Math.PI) / 180), r * Math.sin(((30 + 60 * i) * Math.PI) / 180)].map((v) => +v.toFixed(2));
const outer = [0, 1, 2, 3, 4, 5].map((i) => pt(36, i));
const inner = [0, 1, 2, 3, 4, 5].map((i) => pt(21.6, i));
const lockup = BRAND.style.lockup && BRAND.style.mark === 'hexagon';

// The badge of brand/build.py (mark_badge): bright gold square, a benzene ring pressed into it, L -> P
// on top. Coordinates are in units of the mark size (100); the square spans 10..90.
const badge = BRAND.style.lockup && BRAND.style.mark === 'badge';
const hex = (cx: number, cy: number, r: number) =>
  [0, 1, 2, 3, 4, 5].map((i) => [cx + r * Math.cos(((30 + 60 * i) * Math.PI) / 180), cy + r * Math.sin(((30 + 60 * i) * Math.PI) / 180)].map((v) => +v.toFixed(2)));
const kekule = (cx: number, cy: number, r: number) => {
  const o = hex(cx, cy, r);
  const n = hex(cx, cy, r * 0.62);
  return `M${o.map((q) => q.join(' ')).join('L')}Z` + [0, 2, 4].map((i) => `M${n[i].join(' ')}L${n[(i + 1) % 6].join(' ')}`).join('');
};
const GOLD = ['#E8A600', '#FFF2A6', '#FFCC14']; // brand/build.py BADGE_GOLD
---
<span class="wm">
  {lockup && (
    <svg class="wm-mark" viewBox="-50 -50 100 100" aria-hidden="true">
      <defs>
        <linearGradient id="wm-foil" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" style="stop-color: var(--foil-a)" />
          <stop offset="0.55" style="stop-color: var(--foil-b)" />
          <stop offset="1" style="stop-color: var(--foil-c)" />
        </linearGradient>
      </defs>
      <polygon points={outer.map((q) => q.join(',')).join(' ')} fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
      {[0, 2, 4].map((i) => <line x1={inner[i][0]} y1={inner[i][1]} x2={inner[(i + 1) % 6][0]} y2={inner[(i + 1) % 6][1]} stroke="currentColor" stroke-width="5" />)}
      {outer.slice(0, 5).map((q) => <circle cx={q[0]} cy={q[1]} r="6.2" fill="currentColor" />)}
      <circle class="lit" cx={outer[5][0]} cy={outer[5][1]} r="9.6" />
    </svg>
  )}
  {badge && (
    <svg class="wm-badge" viewBox="10 10 80 80" aria-hidden="true">
      <defs>
        <linearGradient id="wm-gold" x1="1" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color={GOLD[0]} /><stop offset="0.46" stop-color={GOLD[1]} /><stop offset="1" stop-color={GOLD[2]} />
        </linearGradient>
        <linearGradient id="wm-sheen" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.24" /><stop offset="0.5" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <rect x="10" y="10" width="80" height="80" rx="17" fill="url(#wm-gold)" />
      <rect x="10.5" y="10.5" width="79" height="79" rx="16.5" fill="none" stroke="rgb(122,82,0)" stroke-opacity="0.47" stroke-width="1" />
      <path d={kekule(50, 50, 30)} fill="none" stroke="rgb(139,92,0)" stroke-opacity="0.45" stroke-width="2.6" stroke-linejoin="round" />
      <rect x="10" y="10" width="80" height="80" rx="17" fill="url(#wm-sheen)" />
      <g fill="#0B0B0A" stroke="url(#wm-gold)" stroke-width="5" paint-order="stroke" font-family="SpaceGrotesk" font-weight="700" font-size="34">
        <text x="38" y="50" text-anchor="end" dominant-baseline="central">L</text>
        <text x="62" y="50" dominant-baseline="central">P</text>
      </g>
      <path d="M41.4 51.2H58.6M49 43.5l9.6 7.7-9.6 7.7" fill="none" stroke="#0B0B0A" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
  {BRAND.style.wordmark === 'pill' ? (
    <span class="wm-p">Lab<svg viewBox="0 0 125 66" aria-hidden="true"><rect width="125" height="66" rx="33" /><path d="M27.5 33H97.5M73.5 13.8l24 19.2-24 19.2" fill="none" stroke="#0B0B0A" stroke-width="7.5" stroke-linecap="round" stroke-linejoin="round" /></svg>Prod</span>
  ) : BRAND.style.wordmark === 'arrow' ? (
    <span class="wm-a">Lab<svg viewBox="0 0 44 16" aria-hidden="true"><path d="M1 8h40M34 2l7 6-7 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Prod</span>
  ) : (
    <span class="wm-b">lab<i>-to-</i>prod<b aria-hidden="true"></b></span>
  )}
</span>
<style>
  .wm { display: inline-flex; align-items: center; font-weight: 650; font-size: 1.45rem; color: var(--fg); white-space: nowrap; }
  /* about 1.6x the cap height of the 1.25rem mono wordmark, as in the logo lockup */
  .wm-mark { width: 1.8rem; height: 1.8rem; margin-right: 0.28rem; flex: none; color: var(--fg); }
  .wm-mark .lit { fill: url(#wm-foil); }
  /* badge height = 1.8x the cap height of the wordmark, as in the logo lockup */
  .wm-badge { width: 1.85rem; height: 1.85rem; margin-right: 0.55rem; flex: none; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.3)); }
  .wm-p { display: inline-flex; align-items: center; font-family: var(--display); font-weight: 700; letter-spacing: -0.01em; }
  .wm-p svg { width: 1.25em; height: 0.66em; margin: 0.03em 0.22em 0; }
  .wm-p rect { fill: var(--panel-accent); }
  .wm-a { font-family: var(--display); }
  .wm-a svg { width: 1.5em; height: 0.55em; margin: 0 0.28em; color: var(--accent); }
  .wm-b { font-family: var(--mono); font-size: 1.25rem; font-weight: 700; }
  .wm-b i { font-style: normal; color: var(--accent); }
  .wm-b b { display: inline-block; width: 0.5em; height: 1em; margin-left: 0.1em; background: var(--foil, var(--accent)); vertical-align: -0.12em; }
</style>
